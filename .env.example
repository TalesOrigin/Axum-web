# Runtime
APP_ENV=development
HTTP_ADDR=0.0.0.0:3000
PUBLIC_BASE_URL=http://localhost:3000
RUST_LOG=axum_web=info,tower_http=info,sqlx=warn
LOG_FORMAT=pretty
RUN_MIGRATIONS=true

# Database
# Development defaults to a local SQLite file; the parent directory is created automatically.
DATABASE_DRIVER=sqlite
DATABASE_URL=sqlite://./data/axum_web.db?mode=rwc&foreign_keys=true
DATABASE_MIN_CONNECTIONS=1
DATABASE_MAX_CONNECTIONS=5
DATABASE_ACQUIRE_TIMEOUT_SECONDS=10

# To use PostgreSQL instead, set both values together. PostgreSQL remains the recommended
# production database and the existing PostgreSQL migration is kept in migrations/.
# DATABASE_DRIVER=postgres
# DATABASE_URL=postgres://axum_web:CHANGE_ME@localhost:5432/axum_web
# DATABASE_MIN_CONNECTIONS=4
# DATABASE_MAX_CONNECTIONS=50

# Security - use different randomly generated values of at least 32 characters in production
JWT_SECRET=replace-with-64-random-characters-or-secret-manager-reference
JWT_ISSUER=axum-web
ACCESS_TOKEN_TTL_MINUTES=60
LICENSE_KEY_PEPPER=replace-with-64-random-characters-or-secret-manager-reference
DEVICE_ID_PEPPER=replace-with-64-random-characters-or-secret-manager-reference
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Bootstrap only used if there is no admin yet
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

# Licensing controls
LICENSE_HEARTBEAT_WINDOW_SECONDS=600
MAX_KEY_BATCH_SIZE=100
REQUEST_BODY_LIMIT_BYTES=65536
REQUEST_TIMEOUT_SECONDS=30
