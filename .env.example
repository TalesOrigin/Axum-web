# Runtime
APP_ENV=production
HTTP_ADDR=0.0.0.0:3000
PUBLIC_BASE_URL=https://licenses.example.com
RUST_LOG=axum_web=info,tower_http=info,sqlx=warn
LOG_FORMAT=json
RUN_MIGRATIONS=true

# Database
DATABASE_URL=postgres://axum_web:CHANGE_ME@postgres.example.internal:5432/axum_web
DATABASE_MIN_CONNECTIONS=4
DATABASE_MAX_CONNECTIONS=50
DATABASE_ACQUIRE_TIMEOUT_SECONDS=10

# Security - use different randomly generated values of at least 32 characters
JWT_SECRET=replace-with-64-random-characters-or-secret-manager-reference
JWT_ISSUER=axum-web
ACCESS_TOKEN_TTL_MINUTES=60
LICENSE_KEY_PEPPER=replace-with-64-random-characters-or-secret-manager-reference
DEVICE_ID_PEPPER=replace-with-64-random-characters-or-secret-manager-reference
ALLOWED_ORIGINS=https://licenses.example.com,https://admin.example.com

# Bootstrap only used if there is no admin yet
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-one-time-password

# Licensing controls
LICENSE_HEARTBEAT_WINDOW_SECONDS=600
MAX_KEY_BATCH_SIZE=100
REQUEST_BODY_LIMIT_BYTES=65536
REQUEST_TIMEOUT_SECONDS=30
